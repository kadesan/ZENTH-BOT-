# Variables de entorno para el bot de AION 2

# Token del bot de Discord (obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=TU_TOKEN_AQUI

# ID del canal de Discord donde se enviarán las notificaciones
# (Activa el modo desarrollador en Discord: Configuración > Avanzado > Modo desarrollador)
# (Luego clic derecho en el canal > Copiar ID del canal)
DISCORD_CHANNEL_ID=TU_CHANNEL_ID_AQUI

# Zona horaria del bot (America/New_York = Eastern Time = Horario de AION 2 NA East)
# No cambies esto a menos que sepas lo que haces
SERVER_TIMEZONE=America/New_York

# Rol a mencionar en las notificaciones (opcional)
# Formato: @nombre-del-rol  o  deja vacío para no mencionar ningún rol
# Para mencionar @everyone usa: @everyone
# Para mencionar un rol específico: consigue el ID del rol y pon: <@&ROL_ID>
MENTION_ROLE=@everyone
